// ShopCave ER diagram: paste into https://dbdiagram.io (Go to App)

Table customers {
  customer_id bigint [pk, increment]
  full_name varchar(120) [not null]
  email varchar(255) [not null, unique]
  phone varchar(20)
  created_at timestamptz [not null]
}

Table addresses {
  address_id bigint [pk, increment]
  customer_id bigint [not null]
  street varchar(200) [not null]
  city varchar(80) [not null]
  state varchar(40) [not null]
  is_default boolean [not null]
}

Table sellers {
  seller_id bigint [pk, increment]
  business_name varchar(150) [not null]
  email varchar(255) [not null, unique]
  state varchar(40) [not null]
  joined_at timestamptz [not null]
}

Table categories {
  category_id int [pk, increment]
  name varchar(80) [not null, unique]
  parent_id int
}

Table products {
  product_id bigint [pk, increment]
  seller_id bigint [not null]
  category_id int [not null]
  name varchar(200) [not null]
  description text
  unit_price numeric(12,2) [not null, note: 'CHECK >= 0']
  stock_qty int [not null, note: 'CHECK >= 0']
  is_active boolean [not null]
  created_at timestamptz [not null]
}

Table orders {
  order_id bigint [pk, increment]
  customer_id bigint [not null]
  address_id bigint [not null]
  status varchar(20) [not null, note: 'pending, paid, shipped, delivered, cancelled']
  placed_at timestamptz [not null]
}

Table order_items {
  order_id bigint [not null]
  product_id bigint [not null]
  quantity int [not null, note: 'CHECK > 0']
  unit_price numeric(12,2) [not null, note: 'price at time of sale']

  indexes {
    (order_id, product_id) [pk]
  }
}

Table payments {
  payment_id bigint [pk, increment]
  order_id bigint [not null]
  method varchar(20) [not null, note: 'card, transfer, cod']
  amount numeric(12,2) [not null]
  status varchar(20) [not null, note: 'initiated, successful, failed, refunded']
  paid_at timestamptz
}

Table deliveries {
  delivery_id bigint [pk, increment]
  order_id bigint [not null, unique]
  status varchar(20) [not null]
  dispatched_at timestamptz
  delivered_at timestamptz
}

Table reviews {
  review_id bigint [pk, increment]
  product_id bigint [not null]
  customer_id bigint [not null]
  rating smallint [not null, note: '1 to 5']
  comment text
  created_at timestamptz [not null]

  indexes {
    (product_id, customer_id) [unique]
  }
}

Ref: addresses.customer_id > customers.customer_id [delete: cascade]
Ref: categories.parent_id > categories.category_id
Ref: products.seller_id > sellers.seller_id
Ref: products.category_id > categories.category_id
Ref: orders.customer_id > customers.customer_id
Ref: orders.address_id > addresses.address_id
Ref: order_items.order_id > orders.order_id [delete: cascade]
Ref: order_items.product_id > products.product_id
Ref: payments.order_id > orders.order_id
Ref: deliveries.order_id - orders.order_id
Ref: reviews.product_id > products.product_id [delete: cascade]
Ref: reviews.customer_id > customers.customer_id
